# ==============================================================================
# Variáveis de Ambiente para Produção na VPS
# Copie este arquivo para .env na raiz antes de rodar `docker compose up -d`
# ==============================================================================

# Segredo do JWT para autenticação no painel (OBRIGATÓRIO)
# Gere no terminal com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=substitua_por_uma_chave_hex_gerada_com_secrets_token_hex_32

# Modo de execução (sempre false na VPS)
DEBUG=false

# Portas expostas na VPS (configuradas para NÃO conflitar com o app do PDV)
NATURALPANI_FRONTEND_PORT=8080
NATURALPANI_BACKEND_PORT=8123

# Origens autorizadas no CORS (adicione os domínios reais ou IP da VPS)
# Ex: https://cardapio.minhaloja.com.br,http://SEU_IP_VPS:8080
CORS_ORIGINS=http://localhost:8080

# URL que o frontend usará para chamar a API
# Se estiver usando Nginx como proxy reverso roteando /api -> porta 8123 no mesmo domínio, deixe vazio:
VITE_API_URL=
# Se estiver acessando a API diretamente por porta/subdomínio sem reverse proxy unificado:
# VITE_API_URL=http://SEU_IP_VPS:8123

# Configuração de Cookie de Sessão
# Em VPS com mesmo domínio/proxy reverso e HTTPS:
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
# Se for testar na VPS provisoriamente em HTTP puro (sem certificado SSL):
# COOKIE_SECURE=false

# Credenciais iniciais (aplicadas apenas no primeiro seed se a tabela config estiver vazia)
ADMIN_USUARIO_PADRAO=admin
ADMIN_SENHA_PADRAO=admin123
NOME_LOJA_PADRAO=Natural Pani
WHATSAPP_PADRAO=5522981535778

# Duração da sessão em horas
SESSION_HOURS=8
RATE_LIMIT_ENABLED=true

# Cloudflare R2 (Opcional - deixe vazio se for salvar uploads no volume local da VPS)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT_URL=
