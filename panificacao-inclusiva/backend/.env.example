# Copie para .env e preencha. Nunca commite o .env de verdade.

# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# true em dev local, false em produção (desativa /docs e exige HTTPS no cookie)
DEBUG=true

# Deixe o padrão em dev. Em produção com disco não-persistente, troque por um
# Postgres gerenciado (Supabase, Railway, Neon).
DATABASE_URL=sqlite:///./padaria.db

# Origens (separadas por vírgula) autorizadas a chamar a API com cookie.
# Em produção: o domínio real do frontend publicado (ex: https://minha-loja.vercel.app).
CORS_ORIGINS=http://localhost:5173

# Credenciais usadas SÓ na primeira execução (tabela config ainda vazia).
# Banco já existente NÃO é atualizado pelo seed — veja o SQL no final deste arquivo.
ADMIN_USUARIO_PADRAO=admin
ADMIN_SENHA_PADRAO=admin123
NOME_LOJA_PADRAO=Natural Pani
WHATSAPP_PADRAO=5522981535778

# Por quantas horas a sessão da dona da loja fica válida após o login.
SESSION_HOURS=8

# Configuração de cookies de sessão (auth)
# Em dev: lax + false.
# Em produção cross-site (front na Vercel, back no Railway): samesite="none", secure=true.
# Em produção VPS (Nginx servindo front e proxyando /api com HTTPS):
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
COOKIE_SAMESITE=
COOKIE_SECURE=

# Limite de POST /api/admin/login (5 por minuto por IP). false na suíte de testes.
RATE_LIMIT_ENABLED=true

# Cloudflare R2 (S3-compatible) — fotos de marca/produto/upload.
# Sem essas variáveis, o upload cai em /uploads no disco (dev).
# Crie o bucket e as API tokens no painel da Cloudflare; este projeto
# não cria conta nem bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL pública do bucket (r2.dev ou domínio customizado), sem barra no final.
# Ex: https://pub-xxxxxxxx.r2.dev  ou  https://imagens.seudominio.com
# No painel: R2 → bucket → Settings → Public development URL (Allow Access)
# e copie o subdomínio pub-….r2.dev para cá. Sem isto o upload S3 funciona,
# mas o site não tem URL https para o navegador.
R2_PUBLIC_URL=
# Opcional. Padrão: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# ---------------------------------------------------------------------------
# SQL que o app NÃO executa — rode só se autorizar, no SQLite local antigo.
#
# A senha fica no hash bcrypt da coluna pin_hash (nome legado do SQLite).
# Login é usuário + senha. Seed só grava a senha provisória na primeira
# execução; depois a dona troca no painel (must_change_password).
# Backup do arquivo: veja SQLITE.md (python -m app.backup).
#
# URLs de foto no conteúdo antigo ainda apontam para .png/.jpg locais.
# O front já remapeia para o R2, mas o banco fica defasado até este SQL
# (também NÃO rodei):
#
#   UPDATE conteudo_site SET valor = 'https://pub-7f81cf4ca4e246129e38af571fcf5533.r2.dev/brand/photo_storefront_awning.jpg'
#     WHERE chave IN ('hero_imagem', 'galeria3_imagem');
#   UPDATE conteudo_site SET valor = 'https://pub-7f81cf4ca4e246129e38af571fcf5533.r2.dev/brand/photo_baker_apron.jpg'
#     WHERE chave = 'essencia_imagem';
#   UPDATE conteudo_site SET valor = 'https://pub-7f81cf4ca4e246129e38af571fcf5533.r2.dev/brand/photo_store_window.jpg'
#     WHERE chave = 'espaco_imagem';
#   UPDATE conteudo_site SET valor = 'https://pub-7f81cf4ca4e246129e38af571fcf5533.r2.dev/brand/photo_circular_sign.jpg'
#     WHERE chave = 'galeria1_imagem';
#   UPDATE conteudo_site SET valor = 'https://pub-7f81cf4ca4e246129e38af571fcf5533.r2.dev/brand/photo_packaging_bread.jpg'
#     WHERE chave = 'galeria2_imagem';
# ---------------------------------------------------------------------------
