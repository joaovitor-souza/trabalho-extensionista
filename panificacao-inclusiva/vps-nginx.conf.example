# ==============================================================================
# Exemplo de Bloco Nginx para a VPS (Reverse Proxy)
# ==============================================================================
# Se você já tem o Nginx instalado na VPS rodando para o PDV, adicione um novo
# arquivo em `/etc/nginx/sites-available/naturalpani.conf` e ative em
# `/etc/nginx/sites-enabled/`.
#
# Isso permite rodar no mesmo servidor sem conflito de portas, usando um
# subdomínio dedicado (ex: cardapio.seudominio.com.br ou pedidos.seudominio.com.br).
# ==============================================================================

server {
    listen 80;
    server_name cardapio.seudominio.com.br; # <-- Troque pelo seu domínio/subdomínio

    # Tamanho máximo de upload (para fotos de produtos no painel)
    client_max_body_size 10M;

    # Encaminhamento das rotas da API para o container backend (porta 8123)
    location /api/ {
        proxy_pass http://127.0.0.1:8123/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Encaminhamento de uploads de imagens locais (caso não use R2)
    location /uploads/ {
        proxy_pass http://127.0.0.1:8123/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Encaminhamento do frontend da loja e painel admin (porta 8080)
    location / {
        proxy_pass http://127.0.0.1:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
